{
  "name": "takumi",
  "version": "0.1.0",
  "private": true,
  "description": "Takumi backend built as a NestJS microservices workspace.",
  "scripts": {
    "build": "nest build",
    "build:gateway": "nest build api-gateway",
    "build:customers": "nest build customers-service",
    "start:gateway": "nest start api-gateway",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:prod:gateway": "node dist/apps/api-gateway/main.js",
    "start:customers": "nest start customers-service",
    "start:dev:customers": "nest start customers-service --watch",
    "start:prod:customers": "node dist/apps/customers-service/main.js",
    "typecheck": "tsc --noEmit",
    "test:customers": "node -r ts-node/register -r tsconfig-paths/register apps/customers-service/src/application/use-cases/update-customer.service.spec.ts",
    "migration:show": "node -r ts-node/register -r tsconfig-paths/register libs/database/src/migration-command.ts show",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register libs/database/src/migration-command.ts run",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register libs/database/src/migration-command.ts revert",
    "migration:generate": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d libs/database/src/data-source.ts migration:generate",
    "migration:create": "node ./node_modules/typeorm/cli.js migration:create",
    "customers:migration:create": "node ./node_modules/typeorm/cli.js migration:create apps/customers-service/src/migrations/CustomerMigration"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.4.1",
    "joi": "^18.0.2",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^24.1.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
